# Server-only SMTP settings used by app/api/contact/route.ts.
# Do not prefix secrets with NEXT_PUBLIC_; that would expose them to the browser.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_HELO_HOST=jmtshipping.com
CONTACT_EMAIL_FROM="JMT Website <no-reply@jmtshipping.com>"
CONTACT_EMAIL_TO=ops@jmtshipping.com
