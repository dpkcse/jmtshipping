# Server-only SMTP settings used by app/api/contact/route.ts.
# Do not prefix secrets with NEXT_PUBLIC_; that would expose them to the browser.
# The API route defaults to the JMT cPanel mail server values below, so SMTP_PASS
# is the only required secret when these defaults are correct for the deployment.
SMTP_HOST=jmtshipping.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@jmtshipping.com
SMTP_PASS=use-the-email-account-password
SMTP_HELO_HOST=jmtshipping.com
CONTACT_EMAIL_FROM="JMT Website <no-reply@jmtshipping.com>"
CONTACT_EMAIL_TO=ops@jmtshipping.com
